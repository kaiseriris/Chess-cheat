<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/overlay_bg"
        android:padding="14dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/ov_drag_handle"
                android:text="CART3R · ANALYZER"
                android:textColor="@color/neon_red"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:paddingVertical="8dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <Button android:id="@+id/ov_minimize"
                android:text="—" android:textColor="@color/neon_red"
                android:background="@android:color/transparent"
                android:minWidth="36dp" android:minHeight="36dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/ov_expand"
                android:text="⛶" android:textColor="@color/neon_red"
                android:background="@android:color/transparent"
                android:minWidth="36dp" android:minHeight="36dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/ov_refresh"
                android:text="⟳" android:textColor="@color/neon_red"
                android:background="@android:color/transparent"
                android:minWidth="36dp" android:minHeight="36dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/ov_close"
                android:text="✕" android:textColor="@color/neon_red"
                android:background="@android:color/transparent"
                android:minWidth="36dp" android:minHeight="36dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ov_content"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/ov_input"
                android:hint="FEN"
                android:textColor="@color/text_light"
                android:textColorHint="@color/text_muted"
                android:textSize="11sp"
                android:backgroundTint="@color/neon_red"
                android:padding="8dp"
                android:inputType="text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button android:id="@+id/ov_analyze"
                android:text="ANALYZE"
                android:backgroundTint="@color/crimson"
                android:textColor="@color/text_light"
                android:textSize="11sp"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/ov_best"
                android:text="—"
                android:textColor="@color/neon_red"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/ov_score"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/ov_status"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/ov_explain"
                android:textColor="@color/text_light"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/ov_alts"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/ov_resize"
        android:background="@color/neon_red"
        android:layout_gravity="bottom|end"
        android:layout_width="18dp"
        android:layout_height="18dp"/>
</FrameLayout>
